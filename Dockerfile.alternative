# Dockerfile alternativo para evitar problemas de compilação
FROM python:3.9

LABEL maintainer="Rodrigo Rodam"

WORKDIR /nqueen

# Install system dependencies
RUN apt-get update && apt-get install -y \
    gcc \
    g++ \
    libpq-dev \
    postgresql-client \
    python3-dev \
    build-essential \
    && rm -rf /var/lib/apt/lists/*

# Copy requirements and install Python packages
COPY requirements.txt .
RUN pip install --upgrade pip

# Install packages one by one to identify issues easier
RUN pip install --no-cache-dir gunicorn==20.0.0
RUN pip install --no-cache-dir psycopg2-binary==2.9.10
RUN pip install --no-cache-dir Flask==1.1.1
RUN pip install --no-cache-dir Flask-SQLAlchemy==2.4.1

# Install remaining requirements
RUN pip install --no-cache-dir -r requirements.txt

# Copy application code
COPY . .

EXPOSE 8080

# Create non-root user for security
RUN useradd --create-home --shell /bin/bash app && chown -R app:app /nqueen
USER app

ENV PYTHONPATH "${PYTHONPATH}:.:/nqueen"
ENV FLASK_ENV=production

ENTRYPOINT ["gunicorn"]
CMD ["--bind", "0.0.0.0:8080", "--workers", "2", "--timeout", "120", "app.wsgi:application"]